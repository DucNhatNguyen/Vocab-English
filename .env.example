# Copy to .env.local for local runs (never commit real values).
# On Cloudflare Pages set it under Settings > Variables and Secrets.
#
# OneSignal App ID (optional). Leave empty to keep reminders local only: no OneSignal code is loaded.
# It is read at BUILD time (page and sw.js), so rebuild / redeploy after changing it.
VITE_ONESIGNAL_APP_ID=
